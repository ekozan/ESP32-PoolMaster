# Copiez ce fichier en secrets.yaml et remplissez vos valeurs.
wifi_ssid: "MonSSID"
wifi_password: "MonMotDePasseWifi"

# Clé de chiffrement de l'API native (générez-en une : https://esphome.io/components/api.html)
api_encryption_key: "GENEREZ_UNE_CLE_BASE64_DE_32_OCTETS="

ota_password: "MotDePasseOTA"
fallback_ap_password: "MotDePasseAP"

# Authentification de l'interface web embarquée (exemple-webui-wifi-ota.yaml)
web_username: "admin"
web_password: "MotDePasseWeb"

# Optionnel, seulement si le bloc mqtt: est décommenté
mqtt_broker: "192.168.1.10"
mqtt_username: "mqtt_user"
mqtt_password: "mqtt_pass"
